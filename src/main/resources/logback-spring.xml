    <!-- 개발용 Profile -->
    <springProfile name="dev">
        <logger name="org.hibernate" level="DEBUG" />
        <logger name="org.hibernate.SQL" level="DEBUG" />
        <logger name="org.hibernate.type.descriptor.sql" level="DEBUG" />
        <logger name="org.springframework" level="DEBUG" />
        <logger name="org.springframework.data" level="DEBUG" />
        <logger name="org.springframework.orm" level="DEBUG" />
        <logger name="org.mariadb.jdbc" level="DEBUG" />
        <root level="DEBUG">
            <appender-ref ref="CONSOLE"/>
        </root>
    </springProfile>

    <springProfile name="test">

<!--        <logger name="org.hibernate" level="DEBUG" />-->
<!--        <logger name="org.hibernate.SQL" level="DEBUG" />-->
<!--        <logger name="org.hibernate.type.descriptor.sql" level="DEBUG" />-->
<!--        <logger name="org.springframework" level="DEBUG" />-->
<!--        <logger name="org.springframework.data" level="DEBUG" />-->
<!--        <logger name="org.springframework.orm" level="DEBUG" />-->
<!--        <logger name="org.mariadb.jdbc" level="DEBUG" />-->

        <logger name="org.hibernate" level="INFO" />
        <logger name="org.hibernate.SQL" level="INFO" />
        <logger name="org.hibernate.type.descriptor.sql" level="INFO" />
        <logger name="org.springframework" level="INFO" />
        <logger name="org.springframework.data" level="INFO" />
        <logger name="org.springframework.orm" level="INFO" />
        <logger name="org.mariadb.jdbc" level="INFO" />

        <root level="INFO">
<!--            <appender-ref ref="CONSOLE"/>-->
            <appender-ref ref="CONSOLE_JSON"/>      <!--docker log json 출력-->
            <appender-ref ref="JSON_FILE"/>
        </root>
    </springProfile>

    <!-- 운영용 Profile (INFO 이상만 로그로 기록) -->
    <springProfile name="prod">
        <logger name="org.hibernate" level="INFO" />
        <logger name="org.hibernate.SQL" level="INFO" />
        <logger name="org.hibernate.type.descriptor.sql" level="INFO" />
        <logger name="org.springframework" level="INFO" />
        <logger name="org.springframework.data" level="INFO" />
        <logger name="org.springframework.orm" level="INFO" />
        <logger name="org.mariadb.jdbc" level="INFO" />
        <root level="INFO">
<!--            <appender-ref ref="CONSOLE"/>-->
            <appender-ref ref="CONSOLE_JSON"/>      <!--docker log json 출력-->
            <appender-ref ref="JSON_FILE"/>
        </root>
    </springProfile>

