<?xml version="1.0" encoding="UTF-8"?>
<configuration>

    <!-- 공통 패턴: 로그 출력 시간, 레벨, traceId, token, 메서드, URL, 메시지 -->
<!--    <property name="LOGBACK_PATTERN"-->
<!--              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] [%X{trace_id}] [%X{token}] [%X{method} %X{uri}] - %msg%n"/>-->
    <property name="LOGBACK_PATTERN"
              value="%d{yyyy-MM-dd HH:mm:ss.SSS} [%level] [%X{trace_id}] [%X{jti}] [%X{method} %X{uri}] - %msg%n"/>

    <!-- 개발용 Console 로그 -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>${LOGBACK_PATTERN}</pattern>
        </encoder>
    </appender>

    <!-- 운영용 JSON 로그 파일 -->
    <appender name="JSON_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH}/app-json.log</file>   <!--상대경로 처리 /app/logs -> logs로 변경, git action build 시 오류 방지-->
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH}/app-json-%d{yyyy-MM-dd}.log</fileNamePattern>
            <!--            <fileNamePattern>logs/app-json-%d{yyyy-MM-dd_HH_mm}.log</fileNamePattern>-->    <!--분마다 찍히도록 체크-->
            <maxHistory>180</maxHistory>        <!--6개월 보관-->
            <cleanHistoryOnStart>false</cleanHistoryOnStart>    <!--롤링 후에도 app-json.log는 유지-->
        </rollingPolicy>
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <prettyPrint>true</prettyPrint>
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                </timestamp>
                <pattern>
                    <pattern>
                        {
                        "level": "%level",
                        "logger": "%logger",
                        "trace_id": "%X{trace_id}",
                        "jti": "%X{jti}",
                        "method": "%X{method}",
                        "uri": "%X{uri}",
                        "message": "%message"
                        }
                    </pattern>
                </pattern>
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                </stackTrace>
            </providers>
        </encoder>
    </appender>


    <appender name="CONSOLE_JSON" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="net.logstash.logback.encoder.LoggingEventCompositeJsonEncoder">
            <providers>
                <timestamp>
                    <fieldName>timestamp</fieldName>
                </timestamp>
                <logLevel>
                    <fieldName>level</fieldName>
                </logLevel>
                <loggerName>
                    <fieldName>logger</fieldName>
                </loggerName>
                <threadName>
                    <fieldName>thread</fieldName>
                </threadName>
                <mdc /> <!-- trace_id, jti, method, uri 여기서 자동 주입 -->
                <message />
                <stackTrace>
                    <fieldName>stack_trace</fieldName>
                </stackTrace>
            </providers>
        </encoder>
    </appender>

